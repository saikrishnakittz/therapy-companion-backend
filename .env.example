# Therapy Companion Backend - Environment Configuration

# Server Port
PORT=5000

# Node Environment ('development', 'test', 'production')
NODE_ENV=production

# Client Origin for CORS Whitelist
# Can be a single URL, comma-separated list of URLs, or '*' for public access.
# Requests from native mobile apps (no Origin header) are permitted automatically.
CLIENT_ORIGIN=https://therapycompanion.app,http://localhost:8081

# Supabase PostgreSQL Configuration
# Found in your Supabase project dashboard -> Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# NOTE: NEVER set or expose SUPABASE_SERVICE_ROLE_KEY in client applications
# or ordinary user-facing endpoints. All user endpoints use user-scoped JWTs with RLS.


# AI Reflection Provider Configuration
# Options: 'mock' (default for local development & testing, requires NO API key)
#          'openai' (production OpenAI integration, requires OPENAI_API_KEY)
AI_PROVIDER=mock

# OpenAI Integration (Required ONLY if AI_PROVIDER=openai)
# Add your secret API key from https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
